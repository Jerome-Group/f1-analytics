#!/usr/bin/env bash
# Cuts the committed test fixture out of a Session in the running stores, so that what seam 1
# replays is regenerated and reviewed rather than being an opaque blob that quietly stops
# representing the feed.
#
#   bin/fixture
#
# No arguments: which minutes of which Session are worth keeping is the curation, and the
# curation is the point. It lives in the three constants below, where changing it is a diff.
#
# Two recordings come out, of the same five minutes:
#
#   2025-dutch-race         the Session as the Stores hold it. A finished Session has nothing
#                           Gated left in it, so this is the complete picture (ADR-0002)
#   2025-dutch-race-gated   the same window with the timed streams withheld — car positions,
#                           separations, laps — which is what those five minutes would have looked
#                           like inside the Live window before the feed had placed the field
#
# The second is not a mutilation of the first. It is the case the Timing screen has to survive
# without inventing a value, and there is no live Session to record it from on a Tuesday.
set -euo pipefail

session_key=9920
window_from='2025-08-31T13:25:00+00:00'
window_to='2025-08-31T13:30:00+00:00'
# The per-second tier is cut from the close of the window rather than the whole of it, and that is
# the curation the ratio forces: `car_data` runs at around three and a half readings a second per
# car, so five minutes of the field is a hundred and fifty thousand records and thirty seconds is
# three thousand. Thirty seconds is what an opened Driver's trace draws (server/openf1/timeline.ts),
# so it is what the recording has to carry — for every Driver, because "the tier is not sent for a
# Driver nobody opened" is only worth checking against a recording that could have sent it.
trace_from='2025-08-31T13:29:30+00:00'

api="${F1_OPENF1_URL:-http://localhost:8000}"
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

recording="$(mktemp -d)"
trap 'rm -rf -- "$recording"' EXIT

# `drivers` is identity and has no time in it, so it is taken whole. `position` and `intervals` are
# change logs, so a window of position alone would leave most of the field unplaced: the standing at
# the window's first instant is fetched with it, and the two together are what a reader of the window
# sees. `intervals` is taken from inside the window, where the readings already reflect the current
# order. `laps` is discrete, and both the last lap and the best of the Session need every lap run
# before the window ends, not only those inside it, so it is taken up to the window's close.
fetch() {
  local collection="$1" into="$2"
  shift 2
  curl --silent --show-error --fail --max-time 60 --get \
    --data-urlencode "session_key=$session_key" "$@" \
    --output "$recording/$into" "$api/v1/$collection" || {
    cat >&2 <<EOF

$api/v1/$collection did not answer.

Bring the stack up and put the Session in the stores:

  bin/up
  bin/backfill 2025 1267 $session_key
EOF
    exit 1
  }
}

printf 'Cutting %s to %s out of Session %s\n' "$window_from" "$window_to" "$session_key"

fetch drivers drivers.json
fetch position standing.json --data-urlencode "date<=$window_from"
fetch position changes.json --data-urlencode "date>$window_from" \
  --data-urlencode "date<=$window_to"
fetch intervals intervals.json --data-urlencode "date>$window_from" \
  --data-urlencode "date<=$window_to"
fetch laps laps.json --data-urlencode "date_start<=$window_to"
# Stints carry no date — a Stint is a span of laps, not a moment — so the whole strategy is taken and
# which set is current is read off the laps run by the window's close (the Adapter, and #16).
fetch stints stints.json
# The two streams only an opened Driver reads (#18). Radio is discrete and sparse — a handful of
# clips a Driver in a whole race — so it is taken up to the window's close like the laps; telemetry
# is the per-second tier and is taken over the trace window alone, for the reason stated above.
fetch team_radio team_radio.json --data-urlencode "date<=$window_to"
fetch car_data car_data.json --data-urlencode "date>$trace_from" --data-urlencode "date<=$window_to"

python3 - "$recording" "$repo_root/test/fixtures" "$session_key" "$window_from" "$window_to" <<'PY'
"""Turns the recorded responses into the two fixtures, byte-stable across runs."""

import json
import pathlib
import sys
from datetime import datetime, timedelta

recording, fixtures, session_key, window_from, window_to = sys.argv[1:]
recording, fixtures = pathlib.Path(recording), pathlib.Path(fixtures)

# Only the fields the Adapter reads. A fixture that carried whole upstream records would grow
# every time upstream added one, and would invite a test to assert on a field nothing maps.
KEPT = {
    "drivers": ("driver_number", "name_acronym", "team_name"),
    "position": ("driver_number", "date", "position"),
    "intervals": ("driver_number", "date", "gap_to_leader", "interval"),
    # date_start stays on a lap now: the Replay clock needs the moment it completed (#15), and the Gap
    # trend needs the separation that stood then (#16). The three sector durations join it for #18:
    # an opened Driver's laps are read sector by sector, and no other view has width for them.
    "laps": (
        "driver_number", "lap_number", "lap_duration", "date_start",
        "duration_sector_1", "duration_sector_2", "duration_sector_3",
    ),
    "stints": ("driver_number", "stint_number", "lap_start", "lap_end", "compound", "tyre_age_at_start"),
    "team_radio": ("driver_number", "date", "recording_url"),
    # `drs` is not among these on purpose: it is Gated during a Live window and the trace is drawn
    # without it, so a recording that carried it would prove a channel the screen never draws.
    "car_data": ("driver_number", "date", "speed", "throttle", "brake", "n_gear", "rpm"),
}

# The collections written one record to a line rather than pretty-printed. A reviewer reads a diff
# of three thousand telemetry readings by the line, never by the field, and the compact form is a
# third of the bytes for the same information.
PER_LINE = ("car_data",)


def read(name, collection):
    records = json.loads((recording / name).read_text())
    return [{field: record[field] for field in KEPT[collection]} for record in records]


def latest_per_driver(records):
    standing = {}
    for record in sorted(records, key=lambda r: (r["driver_number"], r["date"])):
        standing[record["driver_number"]] = record
    return list(standing.values())


def completed_by(record, instant):
    """A lap is completed once it has both started and had time to finish. A lap still running at
    the window's close — or finishing after it — is not yet a lap the Timing screen has a time for."""
    duration = record["lap_duration"]
    if duration is None:
        return False
    finished = datetime.fromisoformat(record["date_start"]) + timedelta(seconds=duration)
    return finished <= datetime.fromisoformat(instant)


def rendered(collection, records):
    if collection not in PER_LINE:
        return json.dumps(records, indent=2, sort_keys=True) + "\n"
    lines = ",\n".join(json.dumps(record, sort_keys=True) for record in records)
    return f"[\n{lines}\n]\n" if records else "[]\n"


def write(name, collections):
    directory = fixtures / name
    directory.mkdir(parents=True, exist_ok=True)
    for collection, records in collections.items():
        path = directory / f"{collection}.json"
        path.write_text(rendered(collection, records))
        print(f"  {path.relative_to(fixtures.parent.parent)}  {len(records)} records")


drivers = sorted(read("drivers.json", "drivers"), key=lambda r: r["driver_number"])
position = sorted(
    latest_per_driver(read("standing.json", "position")) + read("changes.json", "position"),
    key=lambda r: (r["date"], r["driver_number"]),
)
intervals = sorted(
    latest_per_driver(read("intervals.json", "intervals")),
    key=lambda r: (r["date"], r["driver_number"]),
)
laps = sorted(
    (
        {field: record[field] for field in KEPT["laps"]}
        for record in json.loads((recording / "laps.json").read_text())
        if completed_by(record, window_to)
    ),
    key=lambda r: (r["driver_number"], r["lap_number"]),
)
stints = sorted(read("stints.json", "stints"), key=lambda r: (r["driver_number"], r["stint_number"]))
team_radio = sorted(read("team_radio.json", "team_radio"), key=lambda r: (r["date"], r["driver_number"]))
# By date, then Driver: the trace window is a slice of this list rather than a filter over it
# (server/openf1/timeline.ts), so the order it is written in is the order the reader relies on.
car_data = sorted(read("car_data.json", "car_data"), key=lambda r: (r["date"], r["driver_number"]))

print(f"\nThe window, whole — {window_from} to {window_to}")
write("2025-dutch-race", {
    "drivers": drivers, "position": position, "intervals": intervals, "laps": laps, "stints": stints,
    "team_radio": team_radio, "car_data": car_data,
})

# Telemetry is Gated during a Live window and is withheld here with the rest of the timed streams.
# Radio is not Gated, so it stays: a Driver opened inside a Live window still has something behind
# them, which is the case the panel has to survive without inventing a trace.
print("\nThe same window with the timed streams Gated")
write("2025-dutch-race-gated", {
    "drivers": drivers, "position": [], "intervals": [], "laps": [], "stints": [],
    "team_radio": team_radio, "car_data": [],
})
PY
