{
  "compilerOptions": {
    "lib": ["ES2024"],
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Node runs this TypeScript by stripping the types out of it, so nothing here may need a
    // compiler to mean what it says: no enums, no parameter properties, no import elision, and
    // an import names the file it actually imports (docs/adr/0011).
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["domain", "server", "test"]
}
