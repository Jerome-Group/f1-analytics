#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Mirrors what Formula 1 publishes into the Archive — raw, every feed, decoded by nothing. The
# Stores can be rebuilt from this; this cannot be rebuilt from anything (ADR-0008, CONTEXT.md).
#
#   bin/archive 2025              a whole year
#   bin/archive 2025 1267 9920    one Session
#
# Safe to interrupt and safe to repeat: a Session already held whole is skipped, and a Session
# that was half-fetched is fetched again.
set -euo pipefail

# shellcheck source=lib/environment.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/environment.sh"

usage() {
  cat >&2 <<'EOF'
usage: bin/archive <year> [<meeting-key> <session-key>]

Mirrors every feed Formula 1 publishes — the streams, their key frames, and the team radio audio
the streams reference — into the Archive beside this repository.

Formula 1 no longer serves 2018 or 2022; either is reported rather than retried.

  bin/archive 2025              every Session of the 2025 season
  bin/archive 2025 1267 9920    the 2025 Dutch Grand Prix race alone
EOF
}

case "$#" in
  1 | 3) ;;
  *)
    usage
    exit 64
    ;;
esac

for key in "$@"; do
  case "$key" in
    *[!0-9]*)
      printf '"%s" is not a key — the year, the Meeting and the Session are all numbers.\n\n' \
        "$key" >&2
      usage
      exit 64
      ;;
  esac
done

f1_require_external_volume
mkdir -p "$F1_ARCHIVE_HOME"

# The Archive depends on nothing this project deploys — no virtual machine, no containers, no
# MongoDB. It is the layer beneath all of that, and it must still work when none of it does.
export F1_ARCHIVE_HOME
exec python3 "$F1_REPO_ROOT/archive" "$@"
